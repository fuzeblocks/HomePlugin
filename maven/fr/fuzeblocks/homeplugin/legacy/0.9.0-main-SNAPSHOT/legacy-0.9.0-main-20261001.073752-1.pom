      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r7</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r8</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r9</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r10</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r11</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r12</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r13</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r14</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r15</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r16</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r17</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r18</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r19</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r20</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r21</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r22</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r23</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r24</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r25</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>xyz.xenondevs.invui</groupId>
      <artifactId>inventory-access-r26</artifactId>
      <version>1.49</version>
    </dependency>
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <version>1.20.4-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <id>xenondevs-releases</id>
      <name>xenondevs repository</name>
      <url>https://repo.xenondevs.xyz/releases</url>
    </repository>
  </repositories>
  <build>
    <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>11</release>
          <compilerArgs>
            <arg>-implicit:none</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.6</version>
          </dependency>
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>9.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <relocations>
            <relocation>
              <pattern>org.bstats</pattern>
              <shadedPattern>fr.fuzeblocks.homeplugin.bstats</shadedPattern>
            </relocation>
            <relocation>
              <pattern>net.kyori</pattern>
              <shadedPattern>fr.fuzeblocks.libs.net.kyori</shadedPattern>
            </relocation>
          </relocations>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>module-info.class</exclude>
              </excludes>
            </filter>
          </filters>
          <createDependencyReducedPom>false</createDependencyReducedPom>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
